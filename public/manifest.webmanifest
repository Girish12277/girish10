{
  "id": "/?source=pwa",
  "name": "VLC Web Player",
  "short_name": "VLC Web",
  "description": "Advanced installable VLC-inspired web video player with local file handling, offline shell, skins, EQ, and keyboard control.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#1E1E1E",
  "dir": "ltr",
  "lang": "en",
  "categories": ["entertainment", "multimedia", "video", "music", "utilities"],
  "edge_side_panel": { "preferred_width": 420 },
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "file_handlers": [
    {
      "action": "/?open=file",
      "name": "Open with VLC Web Player",
      "accept": {
        "video/*": [".mp4", ".m4v", ".webm", ".mkv", ".mov", ".avi", ".ogv", ".ogg", ".3gp", ".ts", ".m2ts"],
        "audio/*": [".mp3", ".m4a", ".aac", ".wav", ".flac", ".opus", ".oga"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Open video file",
      "short_name": "Open File",
      "description": "Pick local videos to play.",
      "url": "/?shortcut=open-file",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Open network stream",
      "short_name": "Network",
      "description": "Start from the network stream dialog.",
      "url": "/?shortcut=network-stream",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Skins and God Mode",
      "short_name": "Customize",
      "description": "Open visual skins and advanced customization.",
      "url": "/?shortcut=customize",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Scientific Calculator",
      "short_name": "Calc",
      "description": "Open the offline scientific calculator popup.",
      "url": "/?shortcut=scicalc",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+vlc", "url": "/?stream=%s" }
  ],
  "share_target": {
    "action": "/?shared=1",
    "method": "GET",
    "params": { "title": "title", "text": "stream", "url": "stream" }
  },
  "screenshots": [
    { "src": "/screenshots/desktop.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Desktop video player workspace" },
    { "src": "/screenshots/mobile.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Mobile installable video player" }
  ],
  "icons": [
    { "src": "/favicon.ico", "sizes": "any", "type": "image/x-icon", "purpose": "any" },
    { "src": "/icons/icon-16.png", "sizes": "16x16", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-32.png", "sizes": "32x32", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
